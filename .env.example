# NoteGuard AI - Environment Configuration Template
# Copy this file to .env to customize environment settings.

# Backend FastAPI Configuration
HOST=0.0.0.0
PORT=8000
PYTHONUNBUFFERED=1
TF_ENABLE_ONEDNN_OPTS=0
MPLCONFIGDIR=/tmp/matplotlib

# Database Configuration (Defaults to container SQLite volume)
DATABASE_URL=sqlite:////app/data/noteguard.db

# Frontend Vite Configuration
# In Docker Compose, leave VITE_API_URL empty so requests route through Nginx reverse proxy.
# For standalone local development outside Docker, set to http://127.0.0.1:8000.
VITE_API_URL=

